# 이 파일을 .env로 복사해 채운다. .env는 커밋하지 않는다.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# oauth: 소셜 로그인(운영). demo: 닉네임 로그인과 시연용 가상 매매·경기(키 없이 시험할 때)
SPRING_PROFILES_ACTIVE=oauth
# 운영자 계정 id(쉼표로 구분). 처음 로그인한 뒤 /api/accounts/me의 id를 넣고 다시 띄운다
ADMIN_ACCOUNT_IDS=

# 이용약관·개인정보처리방침에 나오는 운영자(개인정보 보호책임자) 이름과 문의 이메일. 화면 이미지를 빌드할 때 넣는다
OPERATOR_NAME=
OPERATOR_EMAIL=

# 각 제공자 개발자 콘솔에서 받은 키. 콜백 주소: https://{도메인}/login/oauth2/code/{kakao|google}
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 앱 출시 후 AdMob 보상형 광고 단위 id(쉼표로 구분). 비우면 광고 콜백을 모두 거절한다.
# AdMob 콘솔의 서버 측 검증 콜백 주소: https://{도메인}/api/ads/admob/callback
ADMOB_AD_UNITS=

# 경기 일정·결과 수집 키. 제공처마다 하나이고, 같은 키로 여러 대회(리그·컵대회)를 부른다.
# 비운 제공처의 대회만 수집하지 않는다(운영자가 직접 넣는다). 키를 넣은 뒤 구단과 제공처 팀 번호를 잇는다
# (docs/operations.md "경기 데이터 수집")
# API-Sports(https://dashboard.api-sports.io): KBO, K리그, 유로파·컨퍼런스, 각국 컵, 코리아컵, ACL
API_SPORTS_KEY=
# football-data.org(https://www.football-data.org/client/register): 유럽 4대 리그, 챔피언스리그
FOOTBALL_DATA_KEY=
# PandaScore(https://app.pandascore.co): LCK, MSI, 롤드컵
PANDASCORE_KEY=

# 구단 화면 뉴스(네이버 검색 API 뉴스). https://developers.naver.com 애플리케이션 등록에서 "검색" API를 고르면 바로 나온다.
# 하루 25,000회 무료. 비우면 뉴스 탭이 준비 중으로 보인다(docs/operations.md "구단 뉴스")
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 비밀번호 재설정 메일(아이디·비밀번호 가입, docs/operations.md "비밀번호 재설정 메일").
# 비우면 화면에 "비밀번호 찾기"가 보이지 않는다. Gmail은 MAIL_HOST=smtp.gmail.com, MAIL_PASSWORD=앱 비밀번호
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# 매일 DB 덤프 시각(한국 시간)과 보관 일수. 덤프는 deploy/backups에 쌓인다(docs/deploy.md "백업")
BACKUP_AT=04:00
BACKUP_KEEP_DAYS=14

HTTP_PORT=80

# 집 PC 베타: Cloudflare Zero Trust에서 만든 터널 토큰 (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
