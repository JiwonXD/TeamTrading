# 이 파일을 .env로 복사해 채운다. .env는 커밋하지 않는다.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# oauth: 소셜 로그인(운영). demo: 닉네임 로그인과 시연용 가상 매매·경기(키 없이 시험할 때)
SPRING_PROFILES_ACTIVE=oauth
# 운영자 계정 id(쉼표로 구분). 처음 로그인한 뒤 /api/accounts/me의 id를 넣고 다시 띄운다
ADMIN_ACCOUNT_IDS=

# 각 제공자 개발자 콘솔에서 받은 키. 콜백 주소: https://{도메인}/login/oauth2/code/{kakao|naver|google}
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 앱 출시 후 AdMob 보상형 광고 단위 id(쉼표로 구분). 비우면 광고 콜백을 모두 거절한다.
# AdMob 콘솔의 서버 측 검증 콜백 주소: https://{도메인}/api/ads/admob/callback
ADMOB_AD_UNITS=

# 경기 일정·결과 수집(API-Sports, 무료 요금제로 충분). 비우면 수집하지 않고 운영자가 직접 넣는다.
# 키를 넣은 뒤 구단과 제공처 팀 번호를 잇는다(docs/operations.md "경기 데이터 수집")
MATCH_FEED_API_KEY=

HTTP_PORT=80

# 집 PC 베타: Cloudflare Zero Trust에서 만든 터널 토큰 (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
